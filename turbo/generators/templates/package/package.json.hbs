{
  "name": "@workspace/{{ name }}",
  "version": "0.0.0",
  "description": "{{ description }}",
  "type": "module",
  "private": true,
  "license": "UNLICENSED",
{{#if isLeaf}}
  "sideEffects": false,
{{/if}}
  "scripts": {
    "lint": "eslint --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "dependencies": {{#if isReact}}{
    "react": "catalog:"
  }{{else}}{}{{/if}},
  "devDependencies": {
{{#if isReact}}
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
{{else}}
    "@types/node": "catalog:",
{{/if}}
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "@workspace/vitest-config": "workspace:*",
    "eslint": "catalog:",
{{#if isReact}}
    "jsdom": "catalog:",
{{/if}}
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
