# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies (pnpm only; no yarn/PnP artifacts exist in this repo)
node_modules
# Claude Code — commit shared config (skills, agents, rules, settings.json),
# ignore personal/local overrides
.claude/*
!.claude/agents/
!.claude/rules/
!.claude/settings.json
.claude/settings.local.json

# testing
coverage
# vitest 5 writes run artifacts here
.vitest/

# next.js
.next/
out/

# production
build
dist

# turbo
.turbo

# storybook
*storybook.log
storybook-static/

# misc
.DS_Store
*.pem

# debug
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# Next.js 16.3+ auto-generates per-app AI-agent pointer files on `next dev`.
# The root AGENTS.md is the single source of truth (ADR 0008), so ignore the
# generated per-app copies rather than tracking/churning them.
apps/*/AGENTS.md
apps/*/CLAUDE.md

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# playwright (packages/e2e) — reports, artifacts, and saved auth state (never commit sessions)
playwright-report/
blob-report/
test-results/
.auth/


