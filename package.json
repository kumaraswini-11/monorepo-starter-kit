{
  "name": "monorepo-starter-kit",
  "version": "0.0.1",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "format": "prettier --write --cache .",
    "typecheck": "turbo typecheck typecheck:tooling",
    "test": "turbo test",
    "test:integration": "turbo test:integration",
    "test:e2e": "turbo test:e2e",
    "deps:check": "taze -r",
    "knip": "knip",
    "knip:production": "knip --production",
    "gen": "turbo gen",
    "typecheck:tooling": "tsc --noEmit",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@ianvs/prettier-plugin-sort-imports": "catalog:",
    "@turbo/gen": "catalog:",
    "@types/node": "catalog:",
    "@workspace/typescript-config": "workspace:*",
    "eslint": "catalog:",
    "husky": "catalog:",
    "knip": "catalog:",
    "lint-staged": "catalog:",
    "prettier": "catalog:",
    "prettier-plugin-tailwindcss": "catalog:",
    "taze": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  },
  "packageManager": "pnpm@11.28.2",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.21.0",
      "onFail": "download"
    }
  },
  "lint-staged": {
    "{apps,packages}/**/*.{js,mjs,cjs,ts,tsx}": [
      "eslint --max-warnings 0 --no-warn-ignored --fix",
      "prettier --write"
    ],
    "!({apps,packages}/**/*.{js,mjs,cjs,ts,tsx})": "prettier --write --ignore-unknown"
  }
}
