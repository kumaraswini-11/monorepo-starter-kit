# Universal whitespace rules every editor respects natively (editorconfig.org).
# Complements Prettier: Prettier formats code files; this also covers non-code
# files (.env, dotfiles) and applies as you type, in any editor.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false
