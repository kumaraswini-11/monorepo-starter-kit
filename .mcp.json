{
  "mcpServers": {
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer ${GITHUB_PAT}"
      }
    },
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp"
    },
    "better-auth": {
      "type": "http",
      "url": "https://mcp.inkeep.com/better-auth/mcp"
    },
    "shadcn": {
      "command": "pnpm",
      "args": ["dlx", "shadcn@4.21.3", "mcp"]
    },
    "next-devtools": {
      "command": "pnpm",
      "args": ["dlx", "next-devtools-mcp@0.4.0"]
    }
  }
}
