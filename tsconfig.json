{
  // Root-level TypeScript tooling only: the package generator and the knip config. Every
  // workspace package has its own tsconfig (Turborepo guidance); this one must never widen to
  // include them. Type-checked by the root `//#typecheck` task.
  "extends": "@workspace/typescript-config/base.json",
  "include": ["turbo/generators/**/*.ts", "knip.ts"]
}
