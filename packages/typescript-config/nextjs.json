{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Next.js app",
  "extends": "./base.json",
  "compilerOptions": {
    "lib": ["es2024", "dom"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "preserve",
    "allowJs": true,
    "plugins": [{ "name": "next" }]
  }
}
