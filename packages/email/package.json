{
  "name": "@workspace/email",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "lint": "eslint --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "email:dev": "email dev --dir src/emails",
    "email:build": "email build --dir src/emails"
  },
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/types.ts",
    "./render": "./src/render.ts",
    "./messages": "./src/messages.tsx",
    "./send-email": "./src/send-email.ts",
    "./adapters/*": "./src/adapters/*.ts",
    "./components/*": "./src/components/*.tsx",
    "./emails/*": "./src/emails/*.tsx"
  },
  "dependencies": {
    "@react-email/render": "catalog:",
    "@workspace/env": "workspace:*",
    "@workspace/utils": "workspace:*",
    "nodemailer": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-email": "catalog:",
    "server-only": "catalog:"
  },
  "devDependencies": {
    "@react-email/ui": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "@workspace/vitest-config": "workspace:*",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
