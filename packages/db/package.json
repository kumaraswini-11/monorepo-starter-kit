{
  "name": "@workspace/db",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "lint": "eslint --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts",
    "./client": "./src/client.ts",
    "./queries/*": "./src/queries/*.ts",
    "./testing/global-setup": "./test/global-setup.ts",
    "./testing/setup-env": "./test/setup-env.ts",
    "./testing/teardown": "./test/teardown.ts",
    "./testing/reset": "./test/reset.ts",
    "./testing/migrate": "./test/migrate.ts"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "catalog:",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "@workspace/vitest-config": "workspace:*",
    "dotenv": "catalog:",
    "drizzle-kit": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {
    "@workspace/env": "workspace:*",
    "drizzle-orm": "catalog:",
    "pg": "catalog:",
    "server-only": "catalog:"
  }
}
