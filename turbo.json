{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalPassThroughEnv": [
    "DATABASE_URL",
    "BETTER_AUTH_*",
    "SMTP_*",
    "EMAIL_FROM",
    "GOOGLE_CLIENT_ID",
    "GOOGLE_CLIENT_SECRET",
    "SKIP_ENV_VALIDATION",
    "ALLOW_DESTRUCTIVE_DB",
    "DOCKER_HOST",
    "DOCKER_TLS_VERIFY",
    "DOCKER_CERT_PATH",
    "TESTCONTAINERS_*"
  ],
  "tasks": {
    "topo": {
      "dependsOn": ["^topo"]
    },
    "build": {
      "dependsOn": ["^build"],
      "env": ["BETTER_AUTH_URL"],
      "inputs": ["$TURBO_DEFAULT$", ".env*", "!**/*.stories.*", "!**/*.mdx"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**"]
    },
    "build:storybook": {
      "dependsOn": ["topo"],
      "outputs": ["storybook-static/**"]
    },
    "lint": {
      "dependsOn": ["topo"]
    },
    "typecheck": {
      "dependsOn": ["topo"]
    },
    "test": {
      "dependsOn": ["topo"],
      "outputs": ["coverage/**"]
    },
    "test:integration": {
      "cache": false
    },
    "test:e2e": {
      "dependsOn": ["^build"],
      "cache": false,
      "env": ["CI"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "//#format": {
      "cache": false
    }
  },
  "boundaries": {
    "tags": {
      "leaf": {
        "dependencies": { "deny": ["domain", "ui", "app", "test"] }
      },
      "config": {
        "dependencies": { "deny": ["leaf", "domain", "ui", "app", "test"] }
      },
      "domain": {
        "dependencies": { "deny": ["ui", "app", "test"] }
      },
      "ui": {
        "dependencies": { "deny": ["domain", "app", "test"] }
      },
      "app": {
        "dependents": { "deny": ["leaf", "config", "domain", "ui", "app"] }
      },
      "test": {
        "dependents": {
          "deny": ["leaf", "config", "domain", "ui", "app", "test"]
        }
      }
    }
  }
}
