{
  "extends": "@workspace/typescript-config/nextjs.json",
  "compilerOptions": {
    // App-local alias only (ADR 0028). Workspace packages resolve through their
    // `exports` maps — never alias them here.
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "next.config.ts",
    "**/*.ts",
    "**/*.tsx",
    "**/*.mts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
