# Copy to `.env.local` (git-ignored). Never commit real secrets — production
# injects these via the platform's secret store (12-Factor), not a file.
#
# Per Turborepo guidance, env files live in the app that uses them (not the repo
# root). `packages/db` and `packages/auth` run inside this app's process, so they
# read these from `process.env`. drizzle-kit (a separate process) loads this same
# file — see packages/db.

# --- Database (ADR 0019) ---
# Local default matches docker-compose.yml (`docker compose up -d`).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app

# --- Better Auth (ADR 0016) ---
# Generate a secret: `openssl rand -base64 32`
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Extra allowed origins for CSRF / redirect checks (CSV). The BETTER_AUTH_URL origin is
# always trusted; set this for preview/staging domains, a split frontend, or a mobile app.
# BETTER_AUTH_TRUSTED_ORIGINS=https://app.example.com,https://*.preview.example.com
# Telemetry off, no PII leaves the box (ADR 0016).
BETTER_AUTH_TELEMETRY=0

# --- Email / SMTP (ADR 0020) ---
# DEV: leave all of this unset — emails are logged to the server console (the stub adapter).
# PROD: set SMTP_HOST to send for real over Nodemailer/SMTP. Provider-agnostic — Resend / Amazon
# SES / Postmark all work by credentials alone, no code change (ADR 0020).
#
# Using Resend (first provider): create an API key + verify your sending domain at resend.com,
# then use that API key AS the SMTP password. NOTE: we send over SMTP (not the SDK), so there is
# **no separate RESEND_API_KEY** var — the key goes in SMTP_PASSWORD, with SMTP_USER=resend.
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=465                                # 465/2465 = implicit TLS; 587/2587 = STARTTLS
# SMTP_USER=resend                             # literally "resend" for Resend
# SMTP_PASSWORD=re_your_api_key_here           # your Resend API key
# EMAIL_FROM=efferd <noreply@yourdomain.com>   # a sender on your verified domain
# SMTP_SECURE=                                 # optional override; defaults to true on 465/2465
