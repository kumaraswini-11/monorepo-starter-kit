# apps/web environment template. Copy to `.env.local` (git-ignored) and fill in:
#
#   cp apps/web/.env.example apps/web/.env.local
#
# - Values here are PLACEHOLDERS. Never commit real secrets; staging/production inject them
#   from the platform's secret store, not from a file (12-Factor, ADR 0013).
# - Env files live in the app that runs them, never at the repo root (ADR 0013). packages/db,
#   packages/auth and packages/email run inside this app's process and read these values through
#   the validated contract in packages/env — add a new variable to its schema first.
# - REQUIRED variables are uncommented; `pnpm dev` / `next build` fail fast with a clear message
#   if one is missing or malformed. Everything commented out is optional.
# - drizzle-kit (a separate process) loads this app's `.env.local` too — see packages/db.
# - BETTER_AUTH_URL feeds the prerendered metadata, so it is part of the build cache key
#   (turbo.json `build.env`, ADR 0035); the rest are runtime-only.

# =============================================================================================
# REQUIRED
# =============================================================================================

# --- Database (ADR 0012) ---
# Local default matches docker-compose.yml (`docker compose up -d`). Production: your managed or
# self-hosted Postgres connection string. Over a network add `?sslmode=verify-full` (plus
# `sslrootcert=` for a private CA) — `require` stops verifying certificates in pg 9 (ADR 0012).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app

# --- Better Auth (ADR 0011) ---
# At least 32 characters. Generate one per environment (never reuse across environments):
#   openssl rand -base64 32
# The placeholder is deliberately too short: the app refuses to start until you replace it, so a
# copied-but-unedited template can never run with a publicly known secret.
BETTER_AUTH_SECRET=replace-me-openssl-rand-base64
# The app's public origin (scheme + host + port, no trailing slash). Always trusted for CSRF and
# redirect checks.
BETTER_AUTH_URL=http://localhost:3000

# =============================================================================================
# OPTIONAL
# =============================================================================================

# Better Auth telemetry: 0 = off (no data leaves the box). Keep off for a compliance-bound product.
# BETTER_AUTH_TELEMETRY=0

# Extra allowed origins for CSRF / redirect checks (comma-separated), read by Better Auth itself.
# Needed for preview/staging domains, a split frontend, or a mobile app.
# BETTER_AUTH_TRUSTED_ORIGINS=https://app.example.com,https://*.preview.example.com

# --- Email / SMTP (ADR 0014) ---
# Leave ALL unset in development: emails are printed to the server console (stub adapter).
# Setting SMTP_HOST switches packages/email to real sending over Nodemailer/SMTP. Provider-agnostic:
# Resend, Amazon SES, Postmark, … work by credentials alone, no code change.
# SMTP_HOST=your-smtp-host                      # e.g. smtp.resend.com
# SMTP_PORT=465                                 # 465/2465 = implicit TLS; 587/2587 = STARTTLS
# SMTP_SECURE=                                  # optional override; defaults to true on 465/2465
# SMTP_USER=your-smtp-username                  # Resend: literally "resend"
# SMTP_PASSWORD=your-smtp-password-or-api-key   # Resend: the API key (there is no RESEND_API_KEY var)
# EMAIL_FROM=Your Product <noreply@your-verified-domain.com>
# EMAIL_TRANSPORT=console                       # force a transport (smtp | console); production refuses
#                                               # the console stub unless forced (links are bearer tokens)

# --- Google OAuth (ADR 0011) ---
# Leave unset to hide "Continue with Google". To enable, create a Web OAuth client in Google Cloud
# Console (APIs & Services -> Credentials) with the authorized redirect URI
#   <BETTER_AUTH_URL>/api/auth/callback/google   (e.g. http://localhost:3000/api/auth/callback/google)
# and set BOTH values. Better Auth serves the callback route itself.
# GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-google-client-secret

# =============================================================================================
# CI / TOOLING ONLY — never set these in a real runtime
# =============================================================================================
# SKIP_ENV_VALIDATION=1    # lets `next build` run without secrets (CI); runtimes must validate
# ALLOW_DESTRUCTIVE_DB=1   # lets test/e2e helpers reset a NON-local database; dangerous
